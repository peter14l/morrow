# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Firebase Configuration (for Push Notifications)
FIREBASE_API_KEY=your-api-key
FIREBASE_PROJECT_ID=your-project-id

# Payment Gateway Keys
RAZORPAY_KEY_ID=rzp_test_your_id
REVENUECAT_API_KEY=your-revenuecat-key

# Feature Flags
ENABLE_WELLNESS_ENGINE=true
DEBUG_MODE=false
 
# Cloudflare R2 Credentials  
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
  
# Backblaze B2 Credentials  
B2_ENDPOINT=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=

# WebRTC SFU / STUN / TURN Configuration for Scale
WEBRTC_ICE_SERVER_URLS=stun:stun.l.google.com:19302,turn:your-turn-server.com
WEBRTC_ICE_SERVER_USERNAME=your-username
WEBRTC_ICE_SERVER_PASSWORD=your-password

# Reddit Poster Bot API Keys
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USERNAME=your-reddit-username
REDDIT_PASSWORD=your-reddit-password
REDDIT_USER_AGENT=OasisPosterAgent:v1.0