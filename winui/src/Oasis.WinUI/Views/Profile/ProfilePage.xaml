<Page
    x:Class="Oasis.WinUI.Views.Profile.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Oasis.WinUI.Core.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ImageUrlConverter x:Key="ImageUrlConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR — LayerFillColorDefaultBrush is semi-transparent, Mica-compatible -->
        <Border Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Padding="24,32,24,24" Spacing="0">

                    <!-- Avatar -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                        <PersonPicture x:Name="AvatarPicture" Width="100" Height="100" />
                        <Button x:Name="ChangeAvatarBtn"
                                Width="32" Height="32" Padding="0"
                                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                CornerRadius="16"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Click="ChangeAvatarBtn_Click"
                                ToolTipService.ToolTip="Change profile picture">
                            <FontIcon Glyph="&#xE722;" FontSize="14"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- Name -->
                    <TextBlock x:Name="DisplayNameLabel"
                               FontSize="20" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" />

                    <!-- Username + badges -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,4,0,0">
                        <TextBlock x:Name="UsernameLabel" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <FontIcon x:Name="VerifiedBadge" Glyph="&#xE735;" FontSize="13"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  Visibility="Collapsed" />
                        <Border x:Name="ProBadge"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4" Padding="5,1" Visibility="Collapsed">
                            <TextBlock Text="PRO" FontSize="10" FontWeight="Bold"
                                       CharacterSpacing="60"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Email -->
                    <TextBlock x:Name="EmailLabel" FontSize="12" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />

                    <!-- Bio -->
                    <TextBlock x:Name="BioLabel" FontSize="13" TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,12,0,0" Visibility="Collapsed" />

                    <!-- Member since -->
                    <TextBlock x:Name="MemberSinceLabel" FontSize="11" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,8,0,0" />

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,20,0,20" />

                    <!-- Stats grid -->
                    <TextBlock Text="STATISTICS" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatCardStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="PostsCountLabel" Text="—" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Posts" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatCardStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="FollowersCountLabel" Text="—" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Followers" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatCardStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="FollowingCountLabel" Text="—" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Following" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatCardStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="XpLabel" Text="—" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="XP" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,20,0,20" />

                    <!-- Encryption -->
                    <TextBlock Text="ENCRYPTION" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="EncryptionIcon" Glyph="&#xE72E;" FontSize="16" Foreground="#4CAF50" />
                                <TextBlock x:Name="EncryptionLabel" Text="End-to-end encrypted"
                                           FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="PqAuraStatusLabel" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <Button x:Name="EditProfileBtn"
                            Content="Edit Profile"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,20,0,0"
                            Click="EditProfileBtn_Click" />
                    <HyperlinkButton Content="Open Settings"
                                     HorizontalAlignment="Center"
                                     Margin="0,4,0,0"
                                     Click="OpenSettingsBtn_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>


        <!-- MAIN CONTENT — TabView replaces RadioButton toggles -->
        <TabView x:Name="ProfileTabView"
                 Grid.Column="1"
                 IsAddTabButtonVisible="False"
                 TabWidthMode="SizeToContent"
                 VerticalAlignment="Stretch">

            <!-- ── Posts tab ── -->
            <TabViewItem Header="Posts" IsClosable="False" Tag="posts">
                <Grid>
                    <ProgressRing x:Name="LoadingRing" IsActive="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
                        <FontIcon Glyph="&#xEB9F;" FontSize="52"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyStateLabel" Text="No posts yet"
                                   FontSize="15"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Posts grid -->
                    <GridView x:Name="PostsList" Visibility="Collapsed"
                              SelectionMode="None" IsItemClickEnabled="False"
                              Padding="16">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               ItemWidth="204" ItemHeight="204" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="4" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Width="196" Height="196" CornerRadius="10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Padding="12">
                                    <Grid>
                                        <Image Source="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}" Stretch="UniformToFill"
                                               Visibility="{Binding ImageUrl, Converter={StaticResource NullToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="8"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Border Background="#CC000000" Padding="8"
                                                VerticalAlignment="Bottom" Margin="-12" CornerRadius="0,0,10,10"
                                                Visibility="{Binding ImageUrl, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Content}"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis"
                                                       Foreground="White" FontSize="12" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </TabViewItem>

            <!-- ── Saved tab ── -->
            <TabViewItem Header="Saved" IsClosable="False" Tag="saved">
                <Grid>
                    <ProgressRing x:Name="SavedLoadingRing" IsActive="False" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Empty state -->
                    <StackPanel x:Name="SavedEmptyState" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE735;" FontSize="52"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Saved posts will appear here."
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Saved Posts grid -->
                    <GridView x:Name="SavedPostsList" Visibility="Collapsed"
                              SelectionMode="None" IsItemClickEnabled="False"
                              Padding="16">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               ItemWidth="204" ItemHeight="204" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="4" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Width="196" Height="196" CornerRadius="10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Padding="12">
                                    <Grid>
                                        <Image Source="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}" Stretch="UniformToFill"
                                               Visibility="{Binding ImageUrl, Converter={StaticResource NullToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="8"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Border Background="#CC000000" Padding="8"
                                                VerticalAlignment="Bottom" Margin="-12" CornerRadius="0,0,10,10"
                                                Visibility="{Binding ImageUrl, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Content}"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis"
                                                       Foreground="White" FontSize="12" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </TabViewItem>

        </TabView>


    </Grid>
</Page>
