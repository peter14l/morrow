<Page
    x:Class="Oasis.WinUI.Views.Shell.WellnessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Oasis.WinUI.Core.Models"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Stretch">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Wellness &amp; Focus" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Track your digital energy, mindful sessions, and achievements." 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" />
            </StackPanel>

            <!-- Focus Timer Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="Mindful Focus Timer" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TimerDisplay" Text="25:00" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" />
                    
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button x:Name="StartTimerBtn" Content="Start Focus" Style="{ThemeResource AccentButtonStyle}" Click="StartTimerBtn_Click" />
                        <Button x:Name="ResetTimerBtn" Content="Reset" Click="ResetTimerBtn_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Energy & Stats Overview -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Energy Level" FontWeight="SemiBold" FontSize="14" />
                        <ProgressBar x:Name="EnergyProgress" Value="80" Maximum="100" Height="10" />
                        <TextBlock x:Name="EnergyLabel" Text="80% Charged" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Focus Minutes Today" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock x:Name="TodayMinutesLabel" Text="0 mins" FontSize="20" FontWeight="Bold" />
                        <TextBlock x:Name="WeeklyMinutesLabel" Text="This week: 0 mins" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Achievements -->
            <StackPanel Spacing="12">
                <TextBlock Text="Unlocked Achievements" FontWeight="SemiBold" FontSize="16" />
                <ListView x:Name="AchievementsList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,4"
                                    Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" />
                                    <TextBlock Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
