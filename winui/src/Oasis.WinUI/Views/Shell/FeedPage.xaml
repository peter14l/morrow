<Page
    x:Class="Oasis.WinUI.Views.Shell.FeedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Oasis.WinUI.Core.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ImageUrlConverter x:Key="ImageUrlConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />

        <DataTemplate x:Key="PostTemplate">
            <StackPanel Padding="0,10" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PersonPicture Width="36" Height="36"
                                   ProfilePicture="{Binding UserAvatar, Converter={StaticResource ImageUrlConverter}}" />
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Timestamp, Converter={StaticResource DateTimeToStringConverter}}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding CommunityName}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{Binding CommunityName, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Width="32" Height="32" Padding="0"
                            HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE10C;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Delete" Click="DeletePostMenuItem_Click"
                                                CommandParameter="{Binding}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding Content}"
                           TextWrapping="Wrap"
                           TextLineBounds="Tight" />

                <Image Source="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}"
                       MaxHeight="340"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       Visibility="{Binding ImageUrl, Converter={StaticResource NullToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Padding="6,4" Background="Transparent" BorderThickness="0"
                            Click="LikeButton_Click" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xEB51;" FontSize="14" />
                            <TextBlock Text="{Binding Likes}" />
                        </StackPanel>
                    </Button>
                    <Button Padding="6,4" Background="Transparent" BorderThickness="0"
                            Click="CommentButton_Click" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE90A;" FontSize="14" />
                            <TextBlock Text="{Binding Comments}" />
                        </StackPanel>
                    </Button>
                    <Button Padding="6,4" Background="Transparent" BorderThickness="0"
                            Click="BookmarkButton_Click" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                    <Button Padding="6,4" Background="Transparent" BorderThickness="0"
                            Click="ShareButton_Click" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE72D;" FontSize="14" />
                            <TextBlock Text="Share" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Height="1" Margin="0,6,0,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CommentTemplate">
            <StackPanel Padding="0,6" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PersonPicture Width="28" Height="28"
                                   ProfilePicture="{Binding UserAvatar, Converter={StaticResource ImageUrlConverter}}" />
                    <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Timestamp, Converter={StaticResource DateTimeToStringConverter}}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" Margin="34,0,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="34,0,0,0">
                    <Button Padding="4,2" FontSize="12" Background="Transparent" BorderThickness="0"
                            Click="CommentLikeButton_Click" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xEB51;" FontSize="12" />
                            <TextBlock Text="{Binding LikesCount}" />
                        </StackPanel>
                    </Button>
                    <Button Content="Reply" Padding="4,2" FontSize="12"
                            Background="Transparent" BorderThickness="0"
                            Click="CommentReplyButton_Click" CommandParameter="{Binding}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Feed" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="PostStoryBtn" Grid.Column="1" Content="+ Add Story" Click="PostStoryBtn_Click" />
            </Grid>

            <!-- Stories Strip -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ListView x:Name="StoriesStrip"
                          SelectionMode="None"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="64" Spacing="4" Margin="0,0,8,0" HorizontalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="24" BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}" BorderThickness="2" Padding="2" HorizontalAlignment="Center">
                                    <PersonPicture Width="40" Height="40" ProfilePicture="{Binding MediaUrl, Converter={StaticResource ImageUrlConverter}}" />
                                </Border>
                                <TextBlock Text="{Binding Caption}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>

            <TextBox x:Name="ComposerBox"
                     PlaceholderText="Share something..."
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxHeight="96" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" />
                <Button x:Name="PostButton" Content="Post" Style="{StaticResource AccentButtonStyle}"
                        Click="PostButton_Click" />
            </StackPanel>
        </StackPanel>

        <ListView x:Name="FeedList" Grid.Row="1"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  ItemClick="FeedList_ItemClick"
                  ItemTemplate="{StaticResource PostTemplate}">
            <ListView.Footer>
                <Button x:Name="LoadMoreButton" Content="Load more" HorizontalAlignment="Center"
                        Margin="0,8" Click="LoadMoreButton_Click" />
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
