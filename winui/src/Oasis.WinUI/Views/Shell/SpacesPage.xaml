<Page
    x:Class="Oasis.WinUI.Views.Shell.SpacesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Oasis.WinUI.Core.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ImageUrlConverter x:Key="ImageUrlConverter" />
        <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />
        <converters:BoolToTextConverter x:Key="MemberButtonTextConverter" />

        <DataTemplate x:Key="CommunityTemplate">
            <Grid Padding="0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Image Source="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}"
                           Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" FontSize="12" MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding MembersCount}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="members" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" VerticalAlignment="Center"
                        Content="{Binding IsMember, Converter={StaticResource MemberButtonTextConverter}, ConverterParameter=Leave|Join}"
                        Click="JoinLeaveButton_Click"
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12" HorizontalAlignment="Right">
            <Button Content="Create community" Click="CreateCommunityButton_Click" />
            <Button Content="Refresh" Click="RefreshButton_Click" />
        </StackPanel>

        <ListView x:Name="CommunitiesList" Grid.Row="1"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  ItemClick="CommunitiesList_ItemClick"
                  ItemTemplate="{StaticResource CommunityTemplate}" />
    </Grid>
</Page>
