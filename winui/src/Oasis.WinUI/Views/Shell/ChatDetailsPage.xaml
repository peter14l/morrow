<Page
    x:Class="Oasis.WinUI.Views.Shell.ChatDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="600" HorizontalAlignment="Center" Margin="24,16,24,32" Spacing="16">

                <!-- Header / Back Navigation -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Width="40" Height="40" Padding="0"
                            HorizontalAlignment="Left"
                            Click="BackButton_Click">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Text="Chat Details"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </Grid>

                <!-- Profile Card -->
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <PersonPicture x:Name="UserAvatar"
                                       Width="88" Height="88"
                                       HorizontalAlignment="Center" />
                        <TextBlock x:Name="DisplayNameText"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="UsernameText"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />

                        <!-- Quantum Encryption Badge -->
                        <Border Background="#1A00E5FF"
                                BorderBrush="#4D00E5FF"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,6"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="#00E5FF" />
                                <TextBlock Text="PQ-Aura Quantum Encrypted (End-to-End)"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#00E5FF" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Section: Personalization -->
                <TextBlock Text="PERSONALIZATION"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="4,8,0,0" />
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <Grid Padding="4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEB9F;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Chat Wallpaper" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Custom background image for this conversation"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    x:Name="ChangeWallpaperButton"
                                    Content="Change"
                                    Click="ChangeWallpaperButton_Click" />
                        </Grid>

                        <Grid x:Name="WallpaperPreviewPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="8" MaxHeight="120">
                                <Image x:Name="WallpaperPreviewImage"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="1"
                                    x:Name="RemoveWallpaperButton"
                                    Content="Remove"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0"
                                    Click="RemoveWallpaperButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Notifications & Safety -->
                <TextBlock Text="NOTIFICATIONS &amp; SAFETY"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="4,8,0,0" />
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <!-- Mute Toggle -->
                        <Grid Padding="4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="MuteIcon" Glyph="&#xEA8F;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Mute Notifications" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Silence audio and pop-up alerts for this conversation"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          x:Name="MuteToggle"
                                          OnContent="" OffContent=""
                                          Toggled="MuteToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Danger Zone -->
                <TextBlock Text="DANGER ZONE"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Margin="4,8,0,0" />
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <StackPanel Spacing="4">
                        <!-- Clear Chat Button -->
                        <Button x:Name="ClearChatButton"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="ClearChatButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Clear Chat History" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="Delete conversation messages"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <MenuFlyoutSeparator Margin="0,4" />

                        <!-- Block User Button -->
                        <Button x:Name="BlockUserButton"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BlockUserButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="BlockIcon" Glyph="&#xE8D8;" FontSize="18" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="BlockText" Text="Block User" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock x:Name="BlockSubtext"
                                               Text="Prevent this user from messaging or calling you"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
