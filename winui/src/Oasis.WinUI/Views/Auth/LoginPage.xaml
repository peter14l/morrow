<Page
    x:Class="Oasis.WinUI.Views.Auth.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="32"
                Spacing="16">

                <AnimatedVisualPlayer
                    x:Name="LoginLottiePlayer"
                    Width="160"
                    Height="120"
                    HorizontalAlignment="Center" />

                <TextBlock
                    Text="Oasis"
                    FontSize="34"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Welcome back"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />

                <InfoBar x:Name="ErrorBar" IsClosable="False" IsOpen="False" Severity="Error" />

                <TextBox x:Name="IdentifierBox"
                         Header="Email or username"
                         PlaceholderText="you@example.com or @username"
                         IsSpellCheckEnabled="False" />
                <PasswordBox x:Name="PasswordBox"
                             Header="Password"
                             PlaceholderText="Enter your password" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <HyperlinkButton x:Name="ForgotPasswordLink" Content="Forgot password?" />
                    <HyperlinkButton x:Name="RegisterLink" Content="Create an account" />
                </StackPanel>

                <Button x:Name="SignInButton"
                        Content="Sign in"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SignInButton_Click" />
                <Button x:Name="GoogleButton"
                        Content="Continue with Google"
                        HorizontalAlignment="Stretch"
                        Click="GoogleButton_Click" />

                <ProgressRing x:Name="BusyRing"
                              IsActive="False"
                              Width="32" Height="32"
                              HorizontalAlignment="Center"
                              Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,8"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="Post-quantum encrypted messaging" />
    </Grid>
</Page>
