<Page
    x:Class="Oasis.WinUI.Views.Auth.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="32"
                Spacing="16">

                <AnimatedVisualPlayer
                    x:Name="SignUpLottiePlayer"
                    Width="150"
                    Height="110"
                    HorizontalAlignment="Center" />

                <TextBlock
                    Text="Create your account"
                    FontSize="26"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />

                <InfoBar x:Name="ErrorBar" IsClosable="False" IsOpen="False" Severity="Error" />

                <TextBox x:Name="FullNameBox"
                         Header="Full name"
                         PlaceholderText="Your name" />
                <TextBox x:Name="UsernameBox"
                         Header="Username"
                         PlaceholderText="@username" />
                <TextBox x:Name="EmailBox"
                         Header="Email"
                         PlaceholderText="you@example.com"
                         IsSpellCheckEnabled="False" />
                <PasswordBox x:Name="PasswordBox"
                             Header="Password"
                             PlaceholderText="At least 6 characters" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <HyperlinkButton x:Name="SignInLink" Content="Already have an account? Sign in" />
                </StackPanel>

                <Button x:Name="CreateAccountButton"
                        Content="Create account"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="CreateAccountButton_Click" />

                <ProgressRing x:Name="BusyRing"
                              IsActive="False"
                              Width="32" Height="32"
                              HorizontalAlignment="Center"
                              Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
