<Page
    x:Class="Oasis.WinUI.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,10" />
        </Style>
        <Style x:Key="SubDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <!-- Full-width TabView — no left sidebar -->
    <TabView x:Name="SettingsTabView"
             IsAddTabButtonVisible="False"
             TabWidthMode="Equal"
             SelectionChanged="SettingsTabView_SelectionChanged"
             VerticalAlignment="Stretch">

        <!-- ━━━ ACCOUNT & PROFILE ━━━ -->
        <TabViewItem Header="Account" IsClosable="False" Tag="account">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,24" Spacing="0" MaxWidth="680">

                    <TextBlock Text="Account &amp; Profile"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,20" />

                    <!-- Avatar + identity card -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,20,0">
                                <PersonPicture x:Name="AvatarView" Width="80" Height="80" />
                                <Button x:Name="ChangeAvatarButton"
                                        Width="26" Height="26" Padding="0"
                                        VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                        CornerRadius="13"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Click="ChangeAvatarButton_Click"
                                        ToolTipService.ToolTip="Change photo">
                                    <FontIcon Glyph="&#xE722;" FontSize="11"
                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Button>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="UsernameLabel" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="EmailLabel"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="13" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="PROFILE DETAILS" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="14">
                            <TextBox x:Name="UsernameBox" Header="Username" PlaceholderText="@username" />
                            <TextBox x:Name="DisplayNameBox" Header="Display name" PlaceholderText="Your name" />
                            <TextBox x:Name="BioBox" Header="Bio"
                                     PlaceholderText="Tell people about yourself…"
                                     AcceptsReturn="True" MaxLength="160"
                                     TextWrapping="Wrap" Height="80" />
                            <ToggleSwitch x:Name="PrivateAccountToggle"
                                          Header="Private account"
                                          OnContent="On" OffContent="Off"
                                          Toggled="PrivateAccountToggle_Toggled" />
                            <Button Content="Save Changes"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="SaveProfileButton_Click" />
                            <TextBlock x:Name="ProfileStatus" FontSize="12"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DANGER ZONE" Style="{StaticResource SectionLabel}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Border Style="{StaticResource SettingsCardStyle}"
                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Permanently delete your account and all your data. This cannot be undone."
                                       Style="{StaticResource SubDescStyle}" TextWrapping="Wrap" />
                            <Button Content="Delete my account"
                                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                                    Foreground="White"
                                    Click="DeleteAccountButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <!-- ━━━ SECURITY ━━━ -->
        <TabViewItem Header="Security" IsClosable="False" Tag="security">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,24" Spacing="0" MaxWidth="680">

                    <TextBlock Text="Security"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,20" />

                    <TextBlock Text="CHANGE PASSWORD" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="14">
                            <PasswordBox x:Name="NewPasswordBox" Header="New password"
                                         PlaceholderText="At least 6 characters" />
                            <PasswordBox x:Name="ConfirmPasswordBox" Header="Confirm new password"
                                         PlaceholderText="Repeat password" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Update password" Click="UpdatePasswordButton_Click" />
                                <Button Content="Email reset link" Click="SendResetButton_Click" />
                            </StackPanel>
                            <TextBlock x:Name="SecurityStatus" FontSize="12"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="TWO-FACTOR AUTHENTICATION" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Two-factor authentication" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="Add an extra layer of sign-in security."
                                           Style="{StaticResource SubDescStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TwoFaToggle" Grid.Column="1"
                                          OnContent="" OffContent="" IsEnabled="False" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <!-- ━━━ PRIVACY ━━━ -->
        <TabViewItem Header="Privacy" IsClosable="False" Tag="privacy">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,24" Spacing="0" MaxWidth="680">

                    <TextBlock Text="Privacy"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,20" />

                    <TextBlock Text="ACCOUNT VISIBILITY" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Show online status" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="Let others see when you were last active."
                                               Style="{StaticResource SubDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="OnlineStatusToggle" Grid.Column="1"
                                              OnContent="" OffContent="" IsOn="True" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Read receipts" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="Show when you have read messages."
                                               Style="{StaticResource SubDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ReadReceiptsToggle" Grid.Column="1"
                                              OnContent="" OffContent="" IsOn="True" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DATA &amp; GDPR" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Download a copy of your Oasis data including posts, messages, and profile information."
                                       Style="{StaticResource SubDescStyle}" TextWrapping="Wrap" />
                            <Button Content="Request data export" Click="RequestDataExport_Click" />
                            <TextBlock x:Name="DataExportStatus" FontSize="12"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <!-- ━━━ ENCRYPTION ━━━ -->
        <TabViewItem Header="Encryption" IsClosable="False" Tag="encryption">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,24" Spacing="0" MaxWidth="680">

                    <TextBlock Text="Encryption"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,20" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon x:Name="EncryptionStatusIcon" Glyph="&#xE72E;"
                                          FontSize="22" Foreground="#4CAF50" />
                                <StackPanel Spacing="3">
                                    <TextBlock Text="End-to-end encryption"
                                               FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="All messages are encrypted with the Signal Protocol."
                                               Style="{StaticResource SubDescStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="Post-Quantum Encryption (PQ-Aura)"
                                           FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="PqAuraLabel"
                                           Style="{StaticResource SubDescStyle}" TextWrapping="Wrap" />
                                <InfoBar x:Name="PqAuraInfoBar"
                                         IsOpen="True" IsClosable="False"
                                         Severity="Informational"
                                         Message="PQ-Aura adds lattice-based encryption on top of Signal for future-proof security." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="IDENTITY KEY FINGERPRINT" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Your public identity key is used to verify encrypted sessions with other users."
                                       Style="{StaticResource SubDescStyle}" TextWrapping="Wrap" />
                            <TextBox x:Name="PublicKeyBox"
                                     IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                     TextWrapping="Wrap" PlaceholderText="Loading…" Opacity="0.8" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <!-- ━━━ WELLNESS ━━━ -->
        <TabViewItem Header="Wellness" IsClosable="False" Tag="wellness">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,24" Spacing="0" MaxWidth="680">

                    <TextBlock Text="Wellness"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,20" />

                    <!-- XP hero card -->
                    <Border Style="{StaticResource SettingsCardStyle}"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE748;" FontSize="38"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock x:Name="XpSummaryLabel" Text="0 XP"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                <TextBlock Text="Total wellness experience" FontSize="13"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                           Opacity="0.85" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="FOCUS SESSIONS" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Name="SessionsTodayLabel" Text="—" FontSize="26" FontWeight="Bold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Today" Style="{StaticResource SubDescStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="SessionsWeekLabel" Text="—" FontSize="26" FontWeight="Bold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="This week" Style="{StaticResource SubDescStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock x:Name="SessionsTotalLabel" Text="—" FontSize="26" FontWeight="Bold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="All time" Style="{StaticResource SubDescStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="SCREEN TIME" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Daily screen time limit" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock x:Name="ScreenTimeLimitLabel" Grid.Column="1" FontSize="13"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                            <Slider x:Name="ScreenTimeSlider" Minimum="15" Maximum="480" Value="120"
                                    StepFrequency="15" ValueChanged="ScreenTimeSlider_ValueChanged" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Break reminders" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="Notify me to take breaks during focus sessions."
                                               Style="{StaticResource SubDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="BreakReminderToggle" Grid.Column="1"
                                              OnContent="" OffContent="" IsOn="True" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="XP &amp; ACHIEVEMENTS" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Earn XP by completing focus sessions, being consistent, and reaching milestones."
                                       Style="{StaticResource SubDescStyle}" TextWrapping="Wrap" />
                            <ProgressBar x:Name="XpProgressBar" Minimum="0" Maximum="1000" Value="0"
                                         Margin="0,8,0,0" />
                            <TextBlock x:Name="XpNextLevelLabel" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <!-- ━━━ ABOUT ━━━ -->
        <TabViewItem Header="About" IsClosable="False" Tag="about">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,24" Spacing="0" MaxWidth="680">

                    <TextBlock Text="About Oasis"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,20" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <FontIcon Glyph="&#xE774;" FontSize="40"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Oasis" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VersionLabel" Style="{StaticResource SubDescStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Encryption engine"
                                           Style="{StaticResource SubDescStyle}" />
                                <TextBlock x:Name="EncryptionEngineLabel"
                                           Grid.Row="0" Grid.Column="1" FontSize="13" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Platform"
                                           Style="{StaticResource SubDescStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Windows (WinUI 3)" FontSize="13" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Backend"
                                           Style="{StaticResource SubDescStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Supabase" FontSize="13" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

    </TabView>
</Page>
